{
  "name": "@vps/panel-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "24.22.2",
    "pnpm": "12.16.1"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:mock": "vite --host 127.0.0.1 --mode mock",
    "typecheck": "tsc --noEmit",
    "test:boundaries": "node --test tests/*.test.mjs",
    "lint": "eslint src tests vite.config.ts eslint.config.js --max-warnings 0",
    "format": "prettier --write src tests vite.config.ts eslint.config.js package.json tsconfig.json index.html pnpm-workspace.yaml",
    "format:check": "prettier --check src tests vite.config.ts eslint.config.js package.json tsconfig.json index.html pnpm-workspace.yaml",
    "build": "vite build"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@cloudflare/kumo": "2.16.0",
    "@connectrpc/connect": "2.3.0",
    "@connectrpc/connect-query": "2.3.1",
    "@connectrpc/connect-web": "2.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "date-fns": "4.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/babel__core": "7.20.5",
    "@types/babel__traverse": "7.28.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  }
}
